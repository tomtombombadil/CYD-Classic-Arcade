# ESP-IDF settings for every board. PlatformIO turns these into
# sdkconfig.<env> (git-ignored) on the first build.

# ---- Chip, flash, partitions ----
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_COREDUMP_ENABLE_TO_NONE=y

# ---- Bluetooth: the controller only; BTstack is the host stack ----
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
# Dual mode: BR/EDR (PlayStation, Switch Pro, most 8BitDo) and BLE (Xbox)
CONFIG_BTDM_CTRL_MODE_BTDM=y
# One more than CONFIG_BLUEPAD32_MAX_DEVICES (Bluepad32's advice)
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=3
CONFIG_BTDM_CTRL_BLE_MAX_CONN=3
CONFIG_BTDM_CTRL_BR_EDR_MAX_SYNC_CONN=0
CONFIG_BTDM_CTRL_AUTO_LATENCY=y
CONFIG_BTDM_CTRL_MODEM_SLEEP=n
CONFIG_BTDM_CTRL_PINNED_TO_CORE_0=y

# ---- Bluepad32 ----
CONFIG_BLUEPAD32_PLATFORM_CUSTOM=y
# Two controllers at most (two-player games alternate; some may want two)
CONFIG_BLUEPAD32_MAX_DEVICES=2
# No interactive console: saves RAM, the serial log stays
CONFIG_BLUEPAD32_USB_CONSOLE_ENABLE=n
CONFIG_BTSTACK_AUDIO=n
